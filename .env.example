COC_API_TOKEN=Your_COC_API_Token_Here
CLAN_TAG=#Your_Clan_Tag_Here

# Discord webhook for clan notifications (automatic alerts + broadcast.py).
# Create it in Discord: Server Settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/Your_ID/Your_Token

# Optional: run scrapers from your own machine. GitHub Actions IPs rotate, so
# the token there must stay on the RoyaleAPI proxy (default). Locally, point at
# the official API with the token whitelisted to YOUR ip (ifconfig.me).
# COC_API_BASE_URL=https://api.clashofclans.com/v1